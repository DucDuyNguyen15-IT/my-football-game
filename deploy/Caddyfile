# Caddy production (GĐ9.1). SITE_ADDRESS = domain thật khi deploy (Caddy tự lấy chứng chỉ Let's Encrypt
# và chuyển HTTP → HTTPS); mặc định `localhost` dùng chứng chỉ nội bộ của Caddy (trình duyệt cảnh báo).
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Google Đăng nhập (GSI) cần accounts.google.com/gsi; GLTFLoader nạp texture bằng fetch(blob:), bộ giải nén model là WebAssembly.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; frame-src https://accounts.google.com/gsi/; connect-src 'self' wss: blob: data: https://accounts.google.com/gsi/; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Caddy ghi đè X-Forwarded-For bằng IP thật của client (không tin header từ ngoài) → server bật
	# TRUST_PROXY=1 an toàn. Thêm CDN/Cloudflare phía trước thì phải khai `trusted_proxies`.
	handle /api/* {
		reverse_proxy server:3000
	}

	# File có hash trong tên: cache 1 năm. Thiếu file (tab bản cũ xin chunk đã bị thay sau deploy) phải
	# trả 404, không trả index.html 200 kèm cache 1 năm (review main-b T3).
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
