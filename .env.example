# Server (apps/server). Giá trị dưới khớp docker-compose.dev.yml — thiếu biến thì server dùng đúng
# các giá trị dev này (trừ production: phải đặt DATABASE_URL và SESSION_SECRET).
# Chép thành `.env` ở gốc repo để server tự nạp (biến môi trường đặt sẵn được ưu tiên hơn file).
DATABASE_URL=postgres://pitch:pitch@localhost:5432/pitch
DATABASE_URL_TEST=postgres://pitch:pitch@localhost:5432/pitch_test
# Production: chuỗi ngẫu nhiên ≥ 32 ký tự.
SESSION_SECRET=dev-only-session-secret-change-me-please
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Thời gian tối thiểu một trận được nhận thưởng (giây), PRD §7.
MATCH_MIN_DURATION_SEC=360
# =1 mới đăng ký route /api/v1/dev/* (VD cộng xu để test). Mặc định tắt.
ENABLE_DEV_ROUTES=0
# =1 khi chạy sau reverse proxy (Caddy) để rate limit theo IP thật từ X-Forwarded-For. Mặc định tắt.
TRUST_PROXY=0
# OAuth Client ID (loại "Web application") cho đăng nhập Google (ADR-0010), dạng
# xxxx.apps.googleusercontent.com. Để trống = tắt đăng nhập Google (web ẩn nút).
GOOGLE_CLIENT_ID=
